/* ==========================================================
   STYLES DE BASE + VARIABLES COULEURS
   ========================================================== */

/* Variables globales */
:root {
    --color-navy: #0a1929;
    --color-gold: #d4a843;
    --color-gold-light: #f0d080;
    --color-white: #ffffff;
    --color-cream: #f8f6f0;
    --color-gray: #8a8a8a;
    --color-gray-light: #e0e0e0;
    --color-error: #e74c3c;
    --color-success: #2ecc71;
    --shadow-md: 0 8px 32px rgba(0, 0, 0, 0.12);
    --shadow-lg: 0 16px 48px rgba(0, 0, 0, 0.18);
    --radius-card: 16px;
}

/* ==========================================================
   RESET
   ========================================================== */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: 'Plus Jakarta Sans', sans-serif;
    background-color: var(--color-cream);
    color: #1a1a2e;
    line-height: 1.6;
}

.container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
}

/* ==========================================================
   BOUTONS
   ========================================================== */
.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 28px;
    border: none;
    border-radius: 50px;
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    transition: all 0.25s ease;
}

.btn-primary {
    background: var(--color-gold);
    color: var(--color-navy);
}

.btn-primary:hover {
    background: var(--color-gold-light);
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(212, 168, 67, 0.35);
}

.btn-outline {
    background: transparent;
    color: var(--color-navy);
    border: 2px solid var(--color-navy);
}

.btn-outline:hover {
    background: var(--color-navy);
    color: var(--color-cream);
}

.btn-white {
    background: var(--color-white);
    color: var(--color-navy);
}

.btn-white:hover {
    background: var(--color-gold-light);
    transform: translateY(-2px);
}

.btn-lg {
    padding: 16px 40px;
    font-size: 1.05rem;
}

.btn-block {
    width: 100%;
}

.btn-shadow {
    box-shadow: 0 8px 24px rgba(212, 168, 67, 0.35);
}

/* ==========================================================
   HEADER / NAVBAR
   ========================================================== */
.navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    z-index: 1000;
    padding: 12px 0;
}

.navbar-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--color-navy);
    text-decoration: none;
}

.logo-dot {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-gold);
}

.nav-menu {
    display: flex;
    align-items: center;
    gap: 32px;
}

.nav-link {
    text-decoration: none;
    color: var(--color-navy);
    font-weight: 500;
    font-size: 0.95rem;
    transition: color 0.2s;
}

.nav-link:hover {
    color: var(--color-gold);
}

.nav-actions {
    display: flex;
    align-items: center;
    gap: 12px;
}

/* Masquer les éléments "desktop-only" sur mobile */
@media (max-width: 768px) {
    .desktop-only {
        display: none !important;
    }
}

/* Masquer les éléments "mobile-only" sur desktop */
@media (min-width: 769px) {
    .mobile-only {
        display: none !important;
    }
}

/* Menu hamburger (mobile) */
.menu-toggle {
    background: none;
    border: none;
    font-size: 1.8rem;
    cursor: pointer;
    color: var(--color-navy);
    padding: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.menu-toggle .icon-close {
    display: none;
}

.menu-toggle.active .icon-open {
    display: none;
}

.menu-toggle.active .icon-close {
    display: inline-block;
}

/* Menu mobile déroulant */
@media (max-width: 768px) {
    .nav-menu {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: rgba(255, 255, 255, 0.98);
        backdrop-filter: blur(12px);
        flex-direction: column;
        align-items: stretch;
        padding: 24px 32px;
        gap: 16px;
        border-bottom: 1px solid rgba(0, 0, 0, 0.06);
        display: none;
        max-height: 80vh;
        overflow-y: auto;
    }

    .nav-menu.open {
        display: flex;
    }

    .nav-link {
        padding: 10px 0;
        border-bottom: 1px solid rgba(0, 0, 0, 0.04);
    }

    .nav-menu .btn {
        width: 100%;
        justify-content: center;
        margin-top: 4px;
    }
}

/* ==========================================================
   SECTION HÉRO
   ========================================================== */
.hero {
    padding: 140px 0 80px;
    background: linear-gradient(135deg, #f8f6f0 0%, #fffcf5 100%);
}

.hero-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
}

.hero-content h1 {
    font-size: 3.2rem;
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 20px;
    color: var(--color-navy);
}

.text-gradient {
    background: linear-gradient(135deg, var(--color-gold), #d4a843, #f0d080);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.hero-subtitle {
    font-size: 1.15rem;
    color: #3a3a4a;
    max-width: 540px;
    margin-bottom: 32px;
    line-height: 1.7;
}

.hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 36px;
}

.hero-proof {
    display: flex;
    align-items: center;
    gap: 16px;
}

.proof-avatars {
    display: flex;
}

.proof-avatars img {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 2px solid var(--color-cream);
    margin-right: -12px;
    object-fit: cover;
}

.proof-avatars img:last-child {
    margin-right: 0;
}

.badge-hero {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(212, 168, 67, 0.15);
    color: var(--color-gold);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 4px 16px 4px 10px;
    border-radius: 50px;
    margin-bottom: 20px;
    border: 1px solid rgba(212, 168, 67, 0.2);
}

.badge-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-gold);
    animation: pulse-dot 2s infinite;
}

@keyframes pulse-dot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(1.2); }
}

/* Mockup visuel */
.mockup-container {
    background: var(--color-navy);
    border-radius: 20px;
    padding: 16px 16px 0 16px;
    box-shadow: var(--shadow-lg);
}

.mockup-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-bottom: 12px;
}

.mockup-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
}

.mockup-dot.red { background: #ff5f57; }
.mockup-dot.yellow { background: #ffbd2e; }
.mockup-dot.green { background: #28c840; }

.mockup-address {
    margin-left: 12px;
    color: rgba(255, 255, 255, 0.4);
    font-size: 0.75rem;
}

.mockup-img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 12px 12px 0 0;
}

/* ==========================================================
   RESPONSIVE : HÉRO
   ========================================================== */
@media (max-width: 992px) {
    .hero-container {
        grid-template-columns: 1fr;
        text-align: center;
    }

    .hero-subtitle {
        margin-left: auto;
        margin-right: auto;
    }

    .hero-actions {
        justify-content: center;
    }

    .hero-proof {
        justify-content: center;
    }

    .hero-content h1 {
        font-size: 2.6rem;
    }
}

@media (max-width: 576px) {
    .hero-content h1 {
        font-size: 2rem;
    }

    .hero-actions {
        flex-direction: column;
        align-items: stretch;
    }

    .mockup-container {
        border-radius: 12px;
        padding: 10px 10px 0 10px;
    }
}

/* ==========================================================
   SECTION "AUDIENCES" (Fonctionnalités)
   ========================================================== */
.audiences {
    padding: 80px 0;
    background: var(--color-cream);
}

.section-header {
    margin-bottom: 48px;
}

.section-title {
    font-size: 2.4rem;
    font-weight: 800;
    color: var(--color-navy);
}

.section-subtitle {
    font-size: 1.05rem;
    color: #5a5a6a;
    max-width: 600px;
    margin: 12px auto 0;
}

.text-center {
    text-align: center;
}

.audiences-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
}

.audience-card {
    background: var(--color-white);
    padding: 32px 24px;
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-md);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.audience-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
}

.audience-icon-wrapper {
    width: 56px;
    height: 56px;
    background: rgba(212, 168, 67, 0.12);
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
    font-size: 1.6rem;
    color: var(--color-gold);
}

.audience-card h3 {
    font-size: 1.15rem;
    margin-bottom: 8px;
}

.audience-card p {
    color: #5a5a6a;
    font-size: 0.95rem;
}

@media (max-width: 992px) {
    .audiences-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 576px) {
    .audiences-grid {
        grid-template-columns: 1fr;
    }
}

/* ==========================================================
   SECTION "COMMENT ÇA MARCHE"
   ========================================================== */
.how-it-works {
    padding: 80px 0;
    background: var(--color-white);
}

.steps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
}

.step-card {
    text-align: center;
    padding: 32px 20px;
}

.step-number-badge {
    display: inline-block;
    background: var(--color-navy);
    color: var(--color-gold);
    font-weight: 800;
    font-size: 0.8rem;
    padding: 6px 14px;
    border-radius: 50px;
    margin-bottom: 16px;
}

.step-icon {
    font-size: 2.6rem;
    color: var(--color-gold);
    margin-bottom: 16px;
}

.step-card h3 {
    font-size: 1.2rem;
    margin-bottom: 8px;
}

.step-card p {
    color: #5a5a6a;
}

@media (max-width: 768px) {
    .steps-grid {
        grid-template-columns: 1fr;
        max-width: 400px;
        margin: 0 auto;
    }
}

/* ==========================================================
   SECTION TARIFS
   ========================================================== */
.pricing {
    padding: 80px 0;
    background: var(--color-cream);
}

.pricing-toggle-container {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-top: 24px;
}

.toggle-label {
    font-weight: 600;
    color: #5a5a6a;
}

.toggle-label.active {
    color: var(--color-navy);
}

.pricing-toggle-btn {
    width: 48px;
    height: 28px;
    background: var(--color-navy);
    border-radius: 50px;
    border: none;
    position: relative;
    cursor: pointer;
    transition: background 0.3s ease;
}

.pricing-toggle-btn .toggle-thumb {
    display: block;
    width: 22px;
    height: 22px;
    background: var(--color-white);
    border-radius: 50%;
    position: absolute;
    top: 3px;
    left: 3px;
    transition: transform 0.3s ease;
}

.pricing-toggle-btn.annually .toggle-thumb {
    transform: translateX(20px);
}

.badge-saving {
    background: rgba(46, 204, 113, 0.2);
    color: #27ae60;
    padding: 2px 10px;
    border-radius: 50px;
    font-size: 0.7rem;
    font-weight: 700;
}

.pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 40px;
}

.pricing-card {
    background: var(--color-white);
    border-radius: var(--radius-card);
    padding: 32px 24px;
    box-shadow: var(--shadow-md);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    position: relative;
    display: flex;
    flex-direction: column;
}

.pricing-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
}

.pricing-card.featured {
    border: 2px solid var(--color-gold);
    position: relative;
}

.featured-badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-gold);
    color: var(--color-navy);
    font-weight: 700;
    font-size: 0.7rem;
    padding: 4px 20px;
    border-radius: 50px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
}

.pricing-header h3 {
    font-size: 1.3rem;
}

.pricing-header p {
    color: #5a5a6a;
    font-size: 0.9rem;
    margin: 4px 0 16px;
}

.price-display {
    display: flex;
    align-items: baseline;
    gap: 4px;
}

.price-currency {
    font-size: 1.2rem;
    font-weight: 600;
}

.price-amount {
    font-size: 2.8rem;
    font-weight: 800;
    color: var(--color-navy);
}

.price-period {
    color: #5a5a6a;
    font-size: 0.9rem;
}

.pricing-features {
    margin: 24px 0 32px;
    flex-grow: 1;
}

.pricing-features ul {
    list-style: none;
}

.pricing-features li {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 0;
    font-size: 0.95rem;
}

.pricing-features li i {
    color: var(--color-gold);
    flex-shrink: 0;
}

.pricing-features li.disabled {
    opacity: 0.5;
}

.pricing-features li.disabled i {
    color: #ccc;
}

@media (max-width: 992px) {
    .pricing-grid {
        grid-template-columns: 1fr;
        max-width: 420px;
        margin: 40px auto 0;
    }
}

/* ==========================================================
   SECTION SUPPORT & CONTACT
   ========================================================== */
.support-contact {
    padding: 80px 0;
    background: var(--color-white);
}

.support-contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    margin-top: 24px;
}

.support-info-card {
    background: var(--color-cream);
    padding: 40px;
    border-radius: var(--radius-card);
}

.support-header-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(212, 168, 67, 0.12);
    color: var(--color-gold);
    font-weight: 600;
    font-size: 0.8rem;
    padding: 6px 16px;
    border-radius: 50px;
    margin-bottom: 16px;
}

.support-info-card h3 {
    font-size: 1.4rem;
    margin-bottom: 12px;
}

.support-info-card > p {
    color: #5a5a6a;
    margin-bottom: 24px;
}

.support-stats-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.support-stat-item {
    display: flex;
    gap: 16px;
}

.support-stat-icon {
    width: 44px;
    height: 44px;
    background: rgba(212, 168, 67, 0.1);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-gold);
    flex-shrink: 0;
}

.support-stat-item h4 {
    font-size: 1rem;
    margin-bottom: 2px;
}

.support-stat-item p {
    font-size: 0.9rem;
    color: #5a5a6a;
}

.support-form-card {
    background: var(--color-cream);
    padding: 40px;
    border-radius: var(--radius-card);
}

.support-form-card h3 {
    font-size: 1.4rem;
    margin-bottom: 8px;
}

.support-form-card > p {
    color: #5a5a6a;
    margin-bottom: 24px;
}

/* ==========================================================
   FORMULAIRES
   ========================================================== */
.form-group {
    margin-bottom: 16px;
}

.form-group label {
    display: block;
    font-weight: 600;
    font-size: 0.9rem;
    margin-bottom: 4px;
}

.form-group input,
.form-group select,
.form-group textarea {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid #d0d0d0;
    border-radius: 8px;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.95rem;
    transition: border-color 0.2s ease;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
    outline: none;
    border-color: var(--color-gold);
}

.form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
}

.contact-success-msg,
.signup-success-msg {
    text-align: center;
    padding: 20px 0;
}

.success-icon {
    font-size: 3rem;
    color: var(--color-success);
    margin-bottom: 12px;
}

.success-icon i {
    width: 48px;
    height: 48px;
}

@media (max-width: 768px) {
    .support-contact-grid {
        grid-template-columns: 1fr;
    }

    .form-row {
        grid-template-columns: 1fr;
    }
}

/* ==========================================================
   SECTION TÉMOIGNAGES
   ========================================================== */
.testimonials {
    padding: 80px 0;
    background: var(--color-cream);
}

.testimonials-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
}

.testimonial-card {
    background: var(--color-white);
    padding: 28px 24px;
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-md);
}

.testimonial-rating {
    display: flex;
    gap: 2px;
    color: var(--color-gold);
    margin-bottom: 12px;
}

.testimonial-text {
    font-style: italic;
    color: #2a2a3a;
    font-size: 0.98rem;
    margin-bottom: 16px;
    line-height: 1.7;
}

.testimonial-user {
    display: flex;
    align-items: center;
    gap: 12px;
}

.user-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
}

.user-name {
    font-weight: 700;
    display: block;
}

.user-role {
    font-size: 0.8rem;
    color: #5a5a6a;
}

@media (max-width: 992px) {
    .testimonials-grid {
        grid-template-columns: 1fr 1fr;
    }
}

@media (max-width: 576px) {
    .testimonials-grid {
        grid-template-columns: 1fr;
    }
}

/* ==========================================================
   BANNIÈRE CTA
   ========================================================== */
.cta-banner {
    padding: 60px 0;
    background: var(--color-navy);
    color: var(--color-white);
}

.cta-banner h2 {
    font-size: 2.4rem;
    margin-bottom: 12px;
}

.cta-banner p {
    font-size: 1.1rem;
    opacity: 0.8;
    margin-bottom: 28px;
}

/* ==========================================================
   FOOTER
   ========================================================== */
.footer {
    background: var(--color-navy);
    color: rgba(255, 255, 255, 0.8);
    padding-top: 48px;
}

.footer-container {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 40px;
    padding-bottom: 32px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.footer-brand .logo {
    color: var(--color-white);
    margin-bottom: 12px;
}

.footer-desc {
    font-size: 0.9rem;
    max-width: 280px;
    opacity: 0.7;
    line-height: 1.7;
    margin-bottom: 16px;
}

.social-links {
    display: flex;
    gap: 12px;
}

.social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.6);
    transition: background 0.2s ease, color 0.2s ease;
}

.social-link:hover {
    background: var(--color-gold);
    color: var(--color-navy);
}

.footer-links h4,
.footer-contact h4 {
    color: var(--color-white);
    font-size: 1rem;
    margin-bottom: 16px;
}

.footer-links a {
    display: block;
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
    padding: 4px 0;
    font-size: 0.9rem;
    transition: color 0.2s;
}

.footer-links a:hover {
    color: var(--color-gold);
}

.contact-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 0;
    font-size: 0.9rem;
}

.contact-item i {
    opacity: 0.6;
    flex-shrink: 0;
}

.footer-bottom {
    padding: 16px 0;
}

.footer-bottom-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8rem;
    opacity: 0.6;
}

.footer-legal {
    display: flex;
    gap: 20px;
}

.footer-legal a {
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
}

.footer-legal a:hover {
    color: var(--color-gold);
}

@media (max-width: 768px) {
    .footer-container {
        grid-template-columns: 1fr;
        gap: 24px;
    }

    .footer-bottom-container {
        flex-direction: column;
        gap: 8px;
        text-align: center;
    }
}

/* ==========================================================
   MODALE D'INSCRIPTION
   ========================================================== */
.modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(8px);
    z-index: 2000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
}

.modal-overlay.open {
    display: flex;
}

.modal-card {
    background: var(--color-white);
    border-radius: var(--radius-card);
    max-width: 480px;
    width: 100%;
    padding: 40px;
    position: relative;
    max-height: 90vh;
    overflow-y: auto;
}

.modal-close {
    position: absolute;
    top: 16px;
    right: 16px;
    background: none;
    border: none;
    font-size: 1.6rem;
    cursor: pointer;
    color: #5a5a6a;
    transition: color 0.2s;
}

.modal-close:hover {
    color: var(--color-navy);
}

.modal-header {
    margin-bottom: 24px;
}

.modal-header h2 {
    font-size: 1.6rem;
    margin-bottom: 4px;
}

.modal-header p {
    color: #5a5a6a;
}

.modal-form .form-group {
    margin-bottom: 16px;
}

.modal-footer {
    margin-top: 16px;
    text-align: center;
}

.modal-footer a {
    color: var(--color-gold);
    font-weight: 600;
    text-decoration: none;
}

/* ==========================================================
   CHATBOT IA (widget flottant)
   ========================================================== */
.ai-chat-widget {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 1500;
}

/* Bouton d'ouverture du chat */
.ai-chat-toggle {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: var(--color-gold);
    color: var(--color-navy);
    border: none;
    font-size: 1.8rem;
    cursor: pointer;
    box-shadow: var(--shadow-lg);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
}

.ai-chat-toggle:hover {
    transform: scale(1.05);
    box-shadow: 0 12px 36px rgba(212, 168, 67, 0.4);
}

.ai-chat-toggle .icon-chat-close {
    display: none;
}

.ai-chat-toggle.active .icon-chat-open {
    display: none;
}

.ai-chat-toggle.active .icon-chat-close {
    display: inline-block;
}

/* Point de pulsation (pour attirer l'attention) */
.chat-pulse {
    position: absolute;
    top: -4px;
    right: -4px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: #2ecc71;
    border: 2px solid var(--color-white);
    animation: pulse-ring 2s infinite;
}

@keyframes pulse-ring {
    0% {
        transform: scale(0.8);
        opacity: 1;
    }
    100% {
        transform: scale(1.6);
        opacity: 0;
    }
}

/* Panneau de chat */
.ai-chat-panel {
    position: absolute;
    bottom: 76px;
    right: 0;
    width: 360px;
    max-width: 90vw;
    background: var(--color-white);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-lg);
    display: none;
    flex-direction: column;
    overflow: hidden;
}

.ai-chat-panel.open {
    display: flex;
}

/* En-tête du chat */
.ai-chat-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 20px;
    background: var(--color-navy);
    color: var(--color-white);
}

.ai-chat-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--color-gold);
    color: var(--color-navy);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
}

.ai-chat-title-info h3 {
    font-size: 1rem;
    margin: 0;
}

.ai-chat-status {
    font-size: 0.75rem;
    opacity: 0.7;
    display: flex;
    align-items: center;
    gap: 6px;
}

.status-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #2ecc71;
}

/* Corps du chat (messages) */
.ai-chat-body {
    padding: 16px 20px;
    max-height: 280px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
    background: #f8f6f0;
}

.ai-message {
    max-width: 85%;
    padding: 10px 14px;
    border-radius: 12px;
    font-size: 0.9rem;
    line-height: 1.5;
}

.ai-message.system {
    background: var(--color-navy);
    color: var(--color-white);
    align-self: flex-start;
    border-bottom-left-radius: 4px;
}

.ai-message.user {
    background: var(--color-gold);
    color: var(--color-navy);
    align-self: flex-end;
    border-bottom-right-radius: 4px;
}

/* Suggestions de questions */
.ai-chat-suggestions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 12px 20px;
    border-top: 1px solid #eee;
    background: #faf8f4;
}

.suggestion-btn {
    background: var(--color-white);
    border: 1px solid #ddd;
    border-radius: 50px;
    padding: 6px 14px;
    font-size: 0.75rem;
    cursor: pointer;
    transition: all 0.2s ease;
    color: #3a3a4a;
}

.suggestion-btn:hover {
    border-color: var(--color-gold);
    color: var(--color-gold);
}

/* Zone de saisie */
.ai-chat-input-area {
    display: flex;
    gap: 8px;
    padding: 12px 16px;
    border-top: 1px solid #eee;
    background: var(--color-white);
}

.ai-chat-input-area input {
    flex: 1;
    padding: 10px 14px;
    border: 1px solid #ddd;
    border-radius: 50px;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.9rem;
    outline: none;
}

.ai-chat-input-area input:focus {
    border-color: var(--color-gold);
}

.ai-chat-send-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--color-gold);
    color: var(--color-navy);
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s;
}

.ai-chat-send-btn:hover {
    background: var(--color-gold-light);
}

@media (max-width: 480px) {
    .ai-chat-panel {
        width: 100%;
        max-width: 100vw;
        bottom: 70px;
        right: 0;
        border-radius: 12px 12px 0 0;
    }

    .ai-chat-widget {
        bottom: 12px;
        right: 12px;
    }
}
