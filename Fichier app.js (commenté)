// ============================================================
// 6. CHATBOT IA (connexion à l'API Claude)
// ============================================================
const chatToggle = document.getElementById('aiChatToggle');
const chatPanel = document.getElementById('aiChatPanel');
const chatBody = document.getElementById('aiChatBody');
const chatInput = document.getElementById('aiChatInput');
const chatForm = document.getElementById('aiChatForm');
const suggestions = document.querySelectorAll('.suggestion-btn');

// Ouvrir/fermer le chat
chatToggle.addEventListener('click', () => {
    chatToggle.classList.toggle('active');
    chatPanel.classList.toggle('open');
    if (chatPanel.classList.contains('open')) {
        chatInput.focus();
    }
});

// Ajouter un message dans le chat
function addMessage(text, type = 'user') {
    const div = document.createElement('div');
    div.className = `ai-message ${type}`;
    div.innerHTML = `<p>${text.replace(/\n/g, '<br>')}</p>`;
    chatBody.appendChild(div);
    chatBody.scrollTop = chatBody.scrollHeight;
}

// Afficher un "typing..." (indicateur de réponse)
function showTyping() {
    const div = document.createElement('div');
    div.className = 'ai-message system typing';
    div.id = 'typing-indicator';
    div.innerHTML = '<p>🤔 Réflexion en cours...</p>';
    chatBody.appendChild(div);
    chatBody.scrollTop = chatBody.scrollHeight;
}

function hideTyping() {
    const typing = document.getElementById('typing-indicator');
    if (typing) typing.remove();
}

// ==========================================================
// APPEL À L'API CLAUDE VIA NETLIFY FUNCTION
// ==========================================================
async function sendToClaude(question) {
    // Ajouter le message de l'utilisateur
    addMessage(question, 'user');

    // Afficher l'indicateur de chargement
    showTyping();

    // ==========================================================
    // REMPLACER PAR VOTRE ENDPOINT NETLIFY FUNCTION
    // ==========================================================
    const endpoint = '/api/chat';

    try {
        const response = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ 
                question,
                // On peut ajouter un contexte pour personnaliser les réponses
                context: "Tu es l'assistant IA de Convertify, un outil de création de pages de vente. Réponds de manière professionnelle, chaleureuse et concise. Si tu ne sais pas, propose de contacter le support."
            })
        });

        if (!response.ok) {
            throw new Error(`Erreur API: ${response.status}`);
        }

        const data = await response.json();
        // On suppose que la réponse est dans data.answer ou data.reply
        const reply = data.answer || data.reply || "Je n'ai pas compris votre question. Pouvez-vous reformuler ?";

        hideTyping();
        addMessage(reply, 'system');

    } catch (error) {
        console.error('Erreur chat:', error);
        hideTyping();
        addMessage("❌ Désolé, je rencontre un problème technique. Pouvez-vous réessayer ou contacter notre support ?", 'system');
    }
}

// Envoyer un message (formulaire)
chatForm.addEventListener('submit', (e) => {
    e.preventDefault();
    const question = chatInput.value.trim();
    if (!question) return;

    chatInput.value = '';
    sendToClaude(question);
});

// Suggestions rapides
suggestions.forEach(btn => {
    btn.addEventListener('click', () => {
        const question = btn.dataset.question;
        if (question) {
            sendToClaude(question);
        }
    });
});

