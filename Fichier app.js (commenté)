// ============================================================
// 1. GESTION DU MENU MOBILE
// ============================================================
const menuToggle = document.getElementById('menuToggle');
const navMenu = document.getElementById('navMenu');

menuToggle.addEventListener('click', () => {
    menuToggle.classList.toggle('active');
    navMenu.classList.toggle('open');
});

// Fermer le menu en cliquant sur un lien
navMenu.querySelectorAll('.nav-link').forEach(link => {
    link.addEventListener('click', () => {
        menuToggle.classList.remove('active');
        navMenu.classList.remove('open');
    });
});

// ============================================================
// 2. BASCULE TARIFS (mensuel / annuel)
// ============================================================
const billingToggle = document.getElementById('billingToggle');
const monthlyLabel = document.getElementById('billing-monthly');
const annuallyLabel = document.getElementById('billing-annually');
const pricePro = document.getElementById('price-pro');
const priceEnterprise = document.getElementById('price-enterprise');

let isAnnual = false;

billingToggle.addEventListener('click', () => {
    isAnnual = !isAnnual;
    billingToggle.classList.toggle('annually', isAnnual);
    monthlyLabel.classList.toggle('active', !isAnnual);
    annuallyLabel.classList.toggle('active', isAnnual);

    // Mise à jour des prix
    if (isAnnual) {
        // 20% de réduction sur le prix annuel (arrondi)
        pricePro.textContent = Math.round(39 * 0.8);
        priceEnterprise.textContent = Math.round(89 * 0.8);
    } else {
        pricePro.textContent = 39;
        priceEnterprise.textContent = 89;
    }
});

// ============================================================
// 3. MODALE D'INSCRIPTION
// ============================================================
const signupModal = document.getElementById('signupModal');
const closeModal = document.getElementById('closeModal');
const signupForm = document.getElementById('signupForm');
const signupSuccessMsg = document.getElementById('signupSuccessMsg');
const modalFooter = document.getElementById('modalFooter');
const modalSubmitBtn = document.getElementById('modalSubmitBtn');

// Ouvrir la modale (via les boutons .trigger-signup)
document.querySelectorAll('.trigger-signup').forEach(btn => {
    btn.addEventListener('click', () => {
        signupModal.classList.add('open');
        document.body.style.overflow = 'hidden';
    });
});

// Fermer la modale
closeModal.addEventListener('click', () => {
    signupModal.classList.remove('open');
    document.body.style.overflow = '';
});

// Fermer en cliquant à l'extérieur
signupModal.addEventListener('click', (e) => {
    if (e.target === signupModal) {
        signupModal.classList.remove('open');
        document.body.style.overflow = '';
    }
});

// ============================================================
// 4. SOUMISSION DU FORMULAIRE D'INSCRIPTION (→ Airtable)
// ============================================================
signupForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const name = document.getElementById('reg-name').value.trim();
    const email = document.getElementById('reg-email').value.trim();
    const password = document.getElementById('reg-password').value.trim();
    const profile = document.getElementById('reg-profile').value;

    // Validation simple
    if (!name || !email || !password || !profile) {
        alert('Merci de remplir tous les champs.');
        return;
    }

    // Désactiver le bouton pendant l'envoi
    modalSubmitBtn.disabled = true;
    modalSubmitBtn.textContent = 'Envoi en cours...';

    // ==========================================================
    // ENVOI VERS AIRTABLE (remplacer par votre endpoint)
    // ==========================================================
    // TODO : Remplacer par l'URL de votre endpoint Netlify Function
    const endpoint = '/api/subscribe';

    try {
        const response = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name, email, password, profile })
        });

        if (!response.ok) throw new Error('Erreur serveur');

        // Succès : afficher le message de confirmation
        signupForm.style.display = 'none';
        modalFooter.style.display = 'none';
        signupSuccessMsg.style.display = 'block';
        
        // Réinitialiser le formulaire (au cas où)
        signupForm.reset();

    } catch (error) {
        console.error('Erreur inscription:', error);
        alert('Une erreur est survenue. Veuillez réessayer.');
        modalSubmitBtn.disabled = false;
        modalSubmitBtn.textContent = 'Créer mon compte gratuit';
    }
});

