        <!-- Bas de page -->
        <div class="footer-bottom">
            <div class="container footer-bottom-container">
                <p>&copy; 2026 Convertify. Tous droits réservés.</p>
                <div class="footer-legal">
                    <a href="#">Mentions légales</a>
                    <a href="#">Confidentialité</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- ==========================================================
           MODALE D'INSCRIPTION (overlay)
           ========================================================== -->
    <div class="modal-overlay" id="signupModal">
        <div class="modal-card">
            <button class="modal-close" id="closeModal" aria-label="Fermer la modale">
                <i data-lucide="x"></i>
            </button>
            <div class="modal-header">
                <h2 id="modalTitle">Créer votre compte gratuit</h2>
                <p id="modalSubtitle">Rejoignez plus de 5 000 entrepreneurs sur Convertify</p>
            </div>
            
            <!-- ==========================================================
                 FORMULAIRE D'INSCRIPTION (à connecter à Airtable)
                 ========================================================== -->
            <form class="modal-form" id="signupForm">
                <div class="form-group" id="reg-name-group">
                    <label for="reg-name">Nom complet</label>
                    <input type="text" id="reg-name" placeholder="Jean Dupont" required>
                </div>
                <div class="form-group">
                    <label for="reg-email">Adresse email</label>
                    <input type="email" id="reg-email" placeholder="jean.dupont@exemple.com" required>
                </div>
                <div class="form-group">
                    <label for="reg-password">Mot de passe</label>
                    <input type="password" id="reg-password" placeholder="••••••••" required>
                </div>
                <div class="form-group" id="reg-profile-group">
                    <label for="reg-profile">Votre activité principale</label>
                    <select id="reg-profile" required>
                        <option value="" disabled selected>Choisissez votre profil</option>
                        <option value="ecom">E-commerçant</option>
                        <option value="infopreneur">Infopreneur</option>
                        <option value="coach">Coach / Consultant</option>
                        <option value="digital">Vendeur de produits digitaux</option>
                    </select>
                </div>
                <button type="submit" class="btn btn-primary btn-block" id="modalSubmitBtn">Créer mon compte gratuit</button>
            </form>
            
            <!-- Message de confirmation après inscription -->
            <div class="signup-success-msg" id="signupSuccessMsg" style="display:none;">
                <div class="success-icon"><i data-lucide="shield-check"></i></div>
                <h3 id="successTitle">Compte créé avec succès !</h3>
                <p id="successDesc">Bienvenue chez Convertify ! Nous préparons votre espace de travail. Redirection en cours...</p>
            </div>

            <div class="modal-footer" id="modalFooter">
                <p id="switchText">Déjà inscrit ? <a href="#" id="switchModeLink">Se connecter</a></p>
            </div>
        </div>
    </div>

    <!-- ==========================================================
           CHATBOT IA (widget flottant)
           ========================================================== -->
    <div class="ai-chat-widget" id="aiChatWidget">
        <!-- Bouton d'ouverture du chat -->
        <button class="ai-chat-toggle" id="aiChatToggle" aria-label="Ouvrir le chat assistant IA">
            <i data-lucide="message-square" class="icon-chat-open"></i>
            <i data-lucide="x" class="icon-chat-close"></i>
            <span class="chat-pulse"></span>
        </button>
        
        <!-- Panneau de chat -->
        <div class="ai-chat-panel" id="aiChatPanel">
            <div class="ai-chat-header">
                <div class="ai-chat-avatar">
                    <i data-lucide="sparkles"></i>
                </div>
                <div class="ai-chat-title-info">
                    <h3>Assistant IA Convertify</h3>
                    <span class="ai-chat-status"><span class="status-dot"></span> En ligne</span>
                </div>
            </div>
            
            <!-- Zone des messages -->
            <div class="ai-chat-body" id="aiChatBody">
                <div class="ai-message system">
                    <p>Bonjour ! Je suis l'assistant IA de Convertify. 🤖 Comment puis-je vous aider à explorer l'outil ou concevoir votre page de vente ?</p>
                </div>
            </div>
            
            <!-- Suggestions de questions rapides -->
            <div class="ai-chat-suggestions" id="aiChatSuggestions">
                <button class="suggestion-btn" data-question="Qu'est-ce que Convertify ?">Qu'est-ce que Convertify ?</button>
                <button class="suggestion-btn" data-question="Quelles sont les limites du plan gratuit ?">Limites plan gratuit</button>
                <button class="suggestion-btn" data-question="Est-ce adapté aux débutants ?">Adapté aux débutants ?</button>
                <button class="suggestion-btn" data-question="Comment lier Stripe ou PayPal ?">Lier Stripe / PayPal</button>
            </div>
            
            <!-- Zone de saisie du message -->
            <form class="ai-chat-input-area" id="aiChatForm">
                <input type="text" id="aiChatInput" placeholder="Posez votre question..." autocomplete="off" required>
                <button type="submit" class="ai-chat-send-btn" aria-label="Envoyer">
                    <i data-lucide="send"></i>
                </button>
            </form>
        </div>
    </div>

    <!-- ==========================================================
           SCRIPTS
           ========================================================== -->
    <script src="app.js"></script>
    <script>
        // Initialisation des icônes Lucide
        lucide.createIcons();
    </script>
</body>
</html>








