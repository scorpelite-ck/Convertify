                            <div class="user-info">
                                <span class="user-name">Amandine D.</span>
                                <span class="user-role">Coach en développement personnel</span>
                            </div>
                        </div>
                    </div>

                    <!-- Avis 3 : Infopreneur -->
                    <div class="testimonial-card">
                        <div class="testimonial-rating">
                            <i data-lucide="star" class="star-fill"></i>
                            <i data-lucide="star" class="star-fill"></i>
                            <i data-lucide="star" class="star-fill"></i>
                            <i data-lucide="star" class="star-fill"></i>
                            <i data-lucide="star" class="star-fill"></i>
                        </div>
                        <blockquote class="testimonial-text">
                            "J'ai testé tous les outils du marché pour vendre mes formations et mes ebooks. Convertify surpasse de loin la concurrence en termes de vitesse de chargement. Nos scores SEO et mobile sont parfaits, ce qui a réduit nos coûts publicitaires."
                        </blockquote>
                        <div class="testimonial-user">
                            <img src="https://images.unsplash.com/photo-1519085360753-af0119f7cbe7?auto=format&fit=crop&w=100&h=100&q=80" alt="Julien" class="user-avatar">
                            <div class="user-info">
                                <span class="user-name">Julien M.</span>
                                <span class="user-role">Infopreneur & Formateur</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ==========================================================
               BANNIÈRE CTA FINALE (appel à l'action)
               ========================================================== -->
        <section class="cta-banner">
            <div class="container text-center">
                <h2>Prêt à doubler vos ventes ?</h2>
                <p>Créez votre première page de vente Convertify aujourd'hui. Aucune carte de crédit requise.</p>
                <button class="btn btn-white btn-lg trigger-signup">Commencer gratuitement dès maintenant</button>
            </div>
        </section>
    </main>

