<!DOCTYPE html>
<html lang="fr">
<head>
    <!-- ==========================================================
           META & TITRE
           ========================================================== -->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Convertify - Créez des pages de vente ultra-performantes</title>
    <meta name="description" content="Convertify est le logiciel de création de pages de vente ultime pour les e-commerçants, infopreneurs, coachs et vendeurs de produits digitaux. Boostez vos conversions dès aujourd'hui.">
    
    <!-- ==========================================================
           POLICES GOOGLE
           ========================================================== -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- ==========================================================
           FEUILLE DE STYLE CSS
           ========================================================== -->
    <link rel="stylesheet" href="style.css">
    
    <!-- ==========================================================
           LUCIDE ICONS (bibliothèque d'icônes libres)
           ========================================================== -->
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body>

    <!-- ==========================================================
           HEADER / BARRE DE NAVIGATION (fixe en haut)
           ========================================================== -->
    <header class="navbar">
        <div class="container navbar-container">
            <!-- Logo -->
            <a href="#" class="logo">
                <span class="logo-dot"></span>
                Convertify
            </a>
            
            <!-- Menu de navigation (affiché sur desktop, caché sur mobile) -->
            <nav class="nav-menu" id="navMenu">
                <a href="#features" class="nav-link">Fonctionnalités</a>
                <a href="#how-it-works" class="nav-link">Comment ça marche</a>
                <a href="#pricing" class="nav-link">Tarifs</a>
                <a href="#contact-section" class="nav-link">Service Client</a>
                <a href="#testimonials" class="nav-link">Témoignages</a>
                <!-- Ces boutons apparaissent uniquement sur mobile -->
                <button class="btn btn-outline mobile-only trigger-signup">Se connecter</button>
                <button class="btn btn-primary mobile-only trigger-signup">Essai Gratuit</button>
            </nav>

            <!-- Actions dans la navbar (boutons + menu mobile) -->
            <div class="nav-actions">
                <!-- Desktop : boutons visibles sur grand écran -->
                <button class="btn btn-outline desktop-only trigger-signup">Se connecter</button>
                <button class="btn btn-primary desktop-only trigger-signup">Essai Gratuit</button>
                <!-- Mobile : bouton hamburger pour ouvrir/fermer le menu -->
                <button class="menu-toggle" id="menuToggle" aria-label="Ouvrir le menu">
                    <i data-lucide="menu" class="icon-open"></i>
                    <i data-lucide="x" class="icon-close"></i>
                </button>
            </div>
        </div>
    </header>

    <main>
        <!-- ==========================================================
               SECTION HÉRO (premier écran)
               ========================================================== -->
        <section class="hero">
            <div class="container hero-container">
                <div class="hero-content">
                    <!-- Badge d'annonce -->
                    <div class="badge-hero">
                        <span class="badge-dot"></span>
                        Nouveau : Convertify 2.0 est disponible
                    </div>
                    <!-- Titre principal avec dégradé sur le mot clé -->
                    <h1>
                        Créez des pages de vente qui <span class="text-gradient">convertissent vraiment</span>
                    </h1>
                    <!-- Sous-titre qui détaille les cibles -->
                    <p class="hero-subtitle">
                        Conçu spécialement pour les e-commerçants, infopreneurs, coachs et vendeurs de produits digitaux. Transformez vos visiteurs en clients en quelques clics, sans aucune compétence technique.
                    </p>
                    <!-- Boutons d'action -->
                    <div class="hero-actions">
                        <button class="btn btn-primary btn-lg trigger-signup">
                            Commencer l'essai gratuit
                            <i data-lucide="arrow-right"></i>
                        </button>
                        <a href="#how-it-works" class="btn btn-outline btn-lg">
                            <i data-lucide="play-circle"></i>
                            Voir la démo
                        </a>
                    </div>
                    <!-- Preuve sociale : avatars + nombre d'utilisateurs -->
                    <div class="hero-proof">
                        <div class="proof-avatars">
                            <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=100&h=100&q=80" alt="Client 1">
                            <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=100&h=100&q=80" alt="Client 2">
                            <img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&w=100&h=100&q=80" alt="Client 3">
                        </div>
                        <p>Rejoint par plus de <strong>5 000+ créateurs</strong> et entrepreneurs.</p>
                    </div>
                </div>
                <!-- Visuel : mockup de l'éditeur -->
                <div class="hero-visual">
                    <div class="mockup-container">
                        <div class="mockup-header">
                            <span class="mockup-dot red"></span>
                            <span class="mockup-dot yellow"></span>
                            <span class="mockup-dot green"></span>
                            <div class="mockup-address">app.convertify.co/editor</div>
                        </div>
                        <!-- Remplacez cette image par la vôtre -->
                        <img src="assets/hero_mockup.jpg" alt="Convertify Sales Page Editor Dashboard Mockup" class="mockup-img">
                    </div>
                </div>
            </div>
        </section>

        <!-- ==========================================================
               SECTION "AUDIENCES" (Fonctionnalités par persona)
               ========================================================== -->
        <section class="audiences" id="features">
            <div class="container">
                <!-- En-tête de section -->
                <div class="section-header text-center">
                    <h2 class="section-title">Une solution taillée pour votre activité</h2>
                    <p class="section-subtitle">Peu importe ce que vous vendez, Convertify maximise vos taux de conversion.</p>
                </div>
                <!-- Grille des 4 cibles -->
                <div class="audiences-grid">
                    <div class="audience-card">
                        <div class="audience-icon-wrapper">
                            <i data-lucide="shopping-bag"></i>
                        </div>
                        <h3>E-commerçants</h3>
                        <p>Créez des pages mono-produit percutantes pour vos campagnes publicitaires et multipliez vos ventes par deux.</p>
                    </div>
                    <div class="audience-card">
                        <div class="audience-icon-wrapper">
                            <i data-lucide="book-open"></i>
                        </div>
                        <h3>Infopreneurs</h3>
                        <p>Présentez vos formations, ebooks et programmes en ligne de manière irrésistible avec nos structures prêtes à l'emploi.</p>
                    </div>
                    <div class="audience-card">
                        <div class="audience-icon-wrapper">
                            <i data-lucide="users"></i>
                        </div>
                        <h3>Coachs & Consultants</h3>
                        <p>Simplifiez la prise de rendez-vous et vendez vos accompagnements premium avec des tunnels de vente fluides.</p>
                    </div>
                    <div class="audience-card">
                        <div class="audience-icon-wrapper">
                            <i data-lucide="sparkles"></i>
                        </div>
                        <h3>Produits Digitaux</h3>
                        <p>Vendez des templates, logiciels ou abonnements avec un processus de paiement optimisé en une seule étape.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- ==========================================================
               SECTION "COMMENT ÇA MARCHE" (3 étapes)
               ========================================================== -->
        <section class="how-it-works" id="how-it-works">
            <div class="container">
                <div class="section-header text-center">
                    <h2 class="section-title">Comment ça marche ?</h2>
                    <p class="section-subtitle">Lancez votre première page de vente performante en moins de 15 minutes.</p>
                </div>

                <div class="steps-grid">
                    <!-- Étape 1 -->
                    <div class="step-card">
                        <div class="step-number-badge">01</div>
                        <div class="step-icon">
                            <i data-lucide="layout-template"></i>
                        </div>
                        <h3>Sélectionnez un modèle</h3>
                        <p>Choisissez parmi plus de 50 modèles conçus par des experts en copywriting et en conversion psychologique.</p>
                    </div>

                    <!-- Étape 2 -->
                    <div class="step-card">
                        <div class="step-number-badge">02</div>
                        <div class="step-icon">
                            <i data-lucide="mouse-pointer-click"></i>
                        </div>
                        <h3>Personnalisez le contenu</h3>
                        <p>Modifiez le texte, changez les couleurs et intégrez vos visuels en glisser-déposer sans toucher au code.</p>
                    </div>

                    <!-- Étape 3 -->
                    <div class="step-card">
                        <div class="step-number-badge">03</div>
                        <div class="step-icon">
                            <i data-lucide="rocket"></i>
                        </div>
                        <h3>Publiez et encaissez</h3>
                        <p>Connectez Stripe ou PayPal, publiez votre page en un clic et commencez à encaisser vos premiers paiements immédiatement.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- ==========================================================
               SECTION TARIFS (avec toggle mensuel/annuel)
               ========================================================== -->
        <section class="pricing" id="pricing">
            <div class="container">
                <div class="section-header text-center">
                    <h2 class="section-title">Des tarifs clairs et adaptés</h2>
                    <p class="section-subtitle">Commencez gratuitement et faites évoluer votre abonnement selon vos besoins.</p>
                    
                    <!-- Interrupteur mensuel / annuel -->
                    <div class="pricing-toggle-container">
                        <span class="toggle-label active" id="billing-monthly">Mensuel</span>
                        <button class="pricing-toggle-btn" id="billingToggle" aria-label="Changer de facturation">
                            <span class="toggle-thumb"></span>
                        </button>
                        <span class="toggle-label" id="billing-annually">Annuel <span class="badge-saving">-20%</span></span>
                    </div>
                </div>

                <div class="pricing-grid">
                    <!-- Offre 1 : Gratuit -->
                    <div class="pricing-card">
                        <div class="pricing-header">
                            <h3>Gratuit à vie</h3>
                            <p>Pour lancer votre premier produit</p>
                            <div class="price-display">
                                <span class="price-currency">€</span>
                                <span class="price-amount" id="price-starter">0</span>
                                <span class="price-period">/mois</span>
                            </div>
                        </div>
                        <div class="pricing-features">
                            <ul>
                                <li><i data-lucide="check"></i> 1 page de vente active</li>
                                <li><i data-lucide="check"></i> Éditeur glisser-déposer de base</li>
                                <li><i data-lucide="check"></i> Modèles standards</li>
                                <li><i data-lucide="check"></i> Sous-domaine convertify.co</li>
                                <li class="disabled"><i data-lucide="x"></i> A/B Testing & Stats</li>
                                <li class="disabled"><i data-lucide="x"></i> Nom de domaine personnalisé</li>
                            </ul>
                        </div>
                        <div class="pricing-footer">
                            <button class="btn btn-outline btn-block trigger-signup">Commencer gratuitement</button>
                        </div>
                    </div>

                    <!-- Offre 2 : Pro (mise en avant avec badge "Recommandé") -->
                    <div class="pricing-card featured">
                        <div class="featured-badge">Recommandé</div>
                        <div class="pricing-header">
                            <h3>Growth Pro</h3>
                            <p>Idéal pour scaler votre business</p>
                            <div class="price-display">
                                <span class="price-currency">€</span>
                                <span class="price-amount" id="price-pro">39</span>
                                <span class="price-period">/mois</span>
                            </div>
                        </div>
                        <div class="pricing-features">
                            <ul>
                                <li><i data-lucide="check"></i> Pages de vente illimitées</li>
                                <li><i data-lucide="check"></i> Éditeur glisser-déposer Pro</li>
                                <li><i data-lucide="check"></i> Nom de domaine personnalisé</li>
                                <li><i data-lucide="check"></i> Intégration Stripe & PayPal</li>
                                <li><i data-lucide="check"></i> A/B Testing & Stats détaillées</li>
                                <li><i data-lucide="check"></i> Support prioritaire par email</li>
                            </ul>
                        </div>
                        <div class="pricing-footer">
                            <button class="btn btn-primary btn-block btn-shadow trigger-signup">Essayer gratuitement</button>
                        </div>
                    </div>

                    <!-- Offre 3 : Enterprise -->
                    <div class="pricing-card">
                        <div class="pricing-header">
                            <h3>Elite Creator</h3>
                            <p>Pour les créateurs exigeants</p>
                            <div class="price-display">
                                <span class="price-currency">€</span>
                                <span class="price-amount" id="price-enterprise">89</span>
                                <span class="price-period">/mois</span>
                            </div>
                        </div>
                        <div class="pricing-features">
                            <ul>
                                <li><i data-lucide="check"></i> Tout ce qui est dans Pro</li>
                                <li><i data-lucide="check"></i> 5 comptes d'équipe</li>
                                <li><i data-lucide="check"></i> Webhooks & API de connexion</li>
                                <li><i data-lucide="check"></i> Suppression de la marque Convertify</li>
                                <li><i data-lucide="check"></i> Intégration CRM avancée</li>
                                <li><i data-lucide="check"></i> Manager de compte dédié</li>
                            </ul>
                        </div>
                        <div class="pricing-footer">
                            <button class="btn btn-outline btn-block trigger-signup">Essayer gratuitement</button>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ==========================================================
               SECTION SUPPORT CLIENT + FORMULAIRE DE CONTACT
               ========================================================== -->
        <section class="support-contact" id="contact-section">
            <div class="container">
                <div class="section-header text-center">
                    <h2 class="section-title">Besoin d'aide ? Contactez notre Service Client</h2>
                    <p class="section-subtitle">Une question sur l'outil ou un besoin d'assistance ? Notre équipe est là pour vous accompagner.</p>
                </div>
                <div class="support-contact-grid">
                    <!-- Colonne gauche : engagement support -->
                    <div class="support-info-card">
                        <div class="support-header-badge">
                            <i data-lucide="help-circle"></i>
                            Support Client 7j/7
                        </div>
                        <h3>Notre engagement d'excellence</h3>
                        <p>Nous savons que votre business n'attend pas. C'est pourquoi notre équipe technique est disponible pour résoudre vos blocages rapidement.</p>
                        
                        <div class="support-stats-list">
                            <div class="support-stat-item">
                                <div class="support-stat-icon"><i data-lucide="clock"></i></div>
                                <div>
                                    <h4>Temps de réponse moyen</h4>
                                    <p>Moins de 2 heures pour le plan Pro et Enterprise.</p>
                                </div>
                            </div>
                            <div class="support-stat-item">
                                <div class="support-stat-icon"><i data-lucide="check-circle2"></i></div>
                                <div>
                                    <h4>Résolution au premier contact</h4>
                                    <p>94% de nos demandes de support sont résolues dès le premier échange.</p>
                                </div>
                            </div>
                            <div class="support-stat-item">
                                <div class="support-stat-icon"><i data-lucide="shield-check"></i></div>
                                <div>
                                    <h4>Sécurité des intégrations</h4>
                                    <p>Assistance complète sur la liaison de vos comptes Stripe, PayPal et autorépondeurs.</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Colonne droite : formulaire de contact -->
                    <div class="support-form-card">
                        <h3>Envoyez-nous un message</h3>
                        <p>Remplissez le formulaire ci-dessous et un conseiller vous répondra dans les plus brefs délais.</p>
                        <!-- ==========================================================
                             FORMULAIRE DE CONTACT (à connecter à Airtable)
                             ========================================================== -->
                        <form class="contact-form-el" id="contactForm">
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="contact-name">Votre Nom</label>
                                    <input type="text" id="contact-name" placeholder="Votre nom" required>
                                </div>
                                <div class="form-group">
                                    <label for="contact-email">Votre Email</label>
                                    <input type="email" id="contact-email" placeholder="Votre email" required>
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="contact-subject">Sujet de votre demande</label>
                                <select id="contact-subject" required>
                                    <option value="" disabled selected>Choisissez un sujet</option>
                                    <option value="sales">Question commerciale / Tarifs</option>
                                    <option value="tech">Aide technique sur l'éditeur</option>
                                    <option value="billing">Facturation & Paiement</option>
                                    <option value="other">Autre demande</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="contact-message">Message</label>
                                <textarea id="contact-message" rows="5" placeholder="Décrivez votre besoin en détail..." required></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary btn-block">
                                Envoyer le message
                                <i data-lucide="send"></i>
                            </button>
                        </form>
                        <div class="contact-success-msg" id="contactSuccessMsg" style="display:none;">
                            <div class="success-icon"><i data-lucide="check-circle"></i></div>
                            <h4>Message envoyé avec succès !</h4>
                            <p>Merci pour votre message. Notre service client reviendra vers vous sous 2 heures maximum.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ==========================================================
               SECTION TÉMOIGNAGES (3 avis clients)
               ========================================================== -->
